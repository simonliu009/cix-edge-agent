# Edit values if your board uses a different system image or model mirror.
MODEL_ROOT="$PI_CIX_HOME/models"
ASR_MODEL_DIR="$MODEL_ROOT/onnx_sensevoice"
TTS_MODEL_DIR="$MODEL_ROOT/onnx_kokoro"
QWEN_MODEL_DIR="$MODEL_ROOT/Qwen3.5-4B-MNN"
MNN_SOURCE_DIR="$PI_CIX_HOME/source/MNN"
MNN_BUILD_DIR="$MNN_SOURCE_DIR/build-cix-opencl"
MNNCLI_BUILD_DIR="$MNN_SOURCE_DIR/apps/mnncli/build_mnncli"
OPENCL_RUNTIME_LIB="/opt/cixgpu-pro/lib/aarch64-linux-gnu"
CIX_WHEEL_DIR="/usr/share/cix/pypi"
CIX_MODEL_REPO="cix/ai_model_hub_25_Q3"
QWEN_MODEL_REPO="MNN/Qwen3.5-4B-MNN"
MNN_API_HOST="127.0.0.1"
MNN_BACKEND_PORT="8001"
MNN_PROXY_PORT="8000"
PI_PROVIDER="mnn"
PI_MODEL="Qwen3.5-4B-MNN"
PI_TOOLS="read,grep,find,ls"
PI_WORKSPACE_DIR="$PI_CIX_HOME/workspace"
PI_SESSION_FILE="$PI_CIX_HOME/sessions/voice.jsonl"
